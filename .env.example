# MAIN wallet address (receives TRX)
MAIN_WALLET_ADDRESS=TYourMainWalletAddressHere

# SUB wallet private key (must be kept secret!)
SUB_WALLET_PRIVATE_KEY=your_sub_wallet_private_key_here

# Tron network (mainnet or shasta for testnet)
TRON_NETWORK=mainnet

# Polling interval in milliseconds (how often to check for new balance)
POLLING_INTERVAL=5000

# Minimum TRX balance to trigger transfer (in TRX)
MIN_TRANSFER_AMOUNT=1
